{
  "root": true,
  "env": {
    "browser": true,
    "es2022": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "extends": "eslint:recommended",
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "args": "none",
        "varsIgnorePattern": "^_"
      }
    ],
    "no-empty": [
      "error",
      {
        "allowEmptyCatch": true
      }
    ],
    "no-console": "off",
    "no-constant-condition": [
      "error",
      {
        "checkLoops": false
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "extension/*.js"
      ],
      "parserOptions": {
        "sourceType": "script",
        "ecmaFeatures": {
          "globalReturn": true
        }
      },
      "globals": {
        "chrome": "readonly",
        "GM": "writable",
        "GM_addStyle": "readonly",
        "GM_xmlhttpRequest": "readonly",
        "unsafeWindow": "readonly"
      }
    },
    {
      "files": [
        "extension/background.js"
      ],
      "env": {
        "serviceworker": true
      }
    },
    {
      "files": [
        "extension/worker/*.js"
      ],
      "parserOptions": {
        "sourceType": "script",
        "ecmaFeatures": {
          "globalReturn": false
        }
      },
      "env": {
        "serviceworker": true
      },
      "globals": {
        "chrome": "readonly"
      }
    }
  ],
  "ignorePatterns": [
    "examples/"
  ]
}
