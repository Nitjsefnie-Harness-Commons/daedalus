#!/usr/bin/env bash
# Block a push carrying commits whose version strings disagree.
#
# The pre-commit hook is the first line of defence, but it can be bypassed
# (--no-verify), skipped on a machine that never ran the setup below, or
# sidestepped by an amend/rebase. This is the last gate before the drift
# becomes everyone else's problem.
#
# git feeds pre-push one line per ref on stdin:
#   <local ref> <local oid> <remote ref> <remote oid>
# Each local oid is checked, so a push of several branches checks each tip.
set -euo pipefail

root=$(git rev-parse --show-toplevel)
zero=$(git hash-object --stdin </dev/null | tr '[:xdigit:]' '0')
status=0

while read -r _local_ref local_oid _remote_ref _remote_oid; do
    # Branch deletion — nothing being pushed to check.
    [ "$local_oid" = "$zero" ] && continue
    if ! python3 "$root/scripts/check_versions.py" --rev "$local_oid"; then
        status=1
    fi
done

exit $status
